        cout << "[!] Pilihan tidak valid!\n";
        cin.clear(); bersihkanBuffer(); pressEnter(); return;
    }
    bersihkanBuffer();
    Kendaraan tmp[MAX];
    for (int i = 0; i < jmlKendaraan; i++) tmp[i] = daftarKendaraan[i];

    for (int i = 0; i < jmlKendaraan - 1; i++) {
        for (int j = 0; j < jmlKendaraan - 1 - i; j++) {
            bool tukar = false;
            if (pilih == 1) tukar = (strcmp(tmp[j].nama, tmp[j+1].nama) > 0);
            if (pilih == 2) tukar = (strcmp(tmp[j].nama, tmp[j+1].nama) < 0);
            if (pilih == 3) tukar = (tmp[j].harga > tmp[j+1].harga);
            if (pilih == 4) tukar = (tmp[j].harga < tmp[j+1].harga);
            if (tukar) { Kendaraan sw = tmp[j]; tmp[j] = tmp[j+1]; tmp[j+1] = sw; }
        }
    }
    const char* labelSort[] = {"Nama A→Z","Nama Z→A","Harga Termurah","Harga Termahal"};
    cout << "\nHasil Sorting: " << labelSort[pilih-1] << "\n";
    cout << left << setw(5) << "Rank" << setw(6) << "ID" << setw(25) << "Nama"
         << setw(8) << "Tipe" << setw(18) << "Harga/Hari" << "Status\n";
    garis();
    for (int i = 0; i < jmlKendaraan; i++) {
        Kendaraan& k = tmp[i];
        cout << left << setw(5) << i+1 << setw(6) << k.id << setw(25) << k.nama
             << setw(8) << k.jenis;
        cout << "Rp " << setw(14) << fixed << setprecision(0) << k.harga;
        cout << (k.tersedia ? "Tersedia" : "Disewa") << "\n";
    }
    garis();
    pressEnter();
}
void hapusData() {
    header("HAPUS DATA");
    cout << "Hapus data:\n";
    cout << "  1. Kendaraan (hanya yang tidak sedang disewa)\n";
    cout << "  2. Transaksi (hanya yang sudah selesai)\n";
    cout << "  0. Kembali\n";
    cout << "Pilih : ";
    int pilih;
    if (!(cin >> pilih)) { cin.clear(); bersihkanBuffer(); return; }
    bersihkanBuffer();
    if (pilih == 0) return;

    if (pilih == 1) {
        if (jmlKendaraan == 0) {
            cout << "Belum ada data kendaraan.\n"; pressEnter(); return;
        }
        cout << "\nDaftar kendaraan:\n";
        garis();
        for (int i = 0; i < jmlKendaraan; i++) {
            Kendaraan& k = daftarKendaraan[i];
            cout << "ID " << k.id << " - " << k.nama
                 << " [" << k.jenis << "]"
                 << "  Status: " << (k.tersedia ? "Tersedia" : "SEDANG DISEWA") << "\n";
        }
        garis();
        cout << "Masukkan ID kendaraan yang dihapus : ";
        int idHapus;
        if (!(cin >> idHapus)) { cin.clear(); bersihkanBuffer(); pressEnter(); return; }
        bersihkanBuffer();
        int idx = cariIdxKendaraan(idHapus);
        if (idx == -1) { cout << "[!] ID tidak ditemukan.\n"; pressEnter(); return; }
        if (!daftarKendaraan[idx].tersedia) {
            cout << "[!] Kendaraan sedang disewa. Tidak bisa dihapus!\n"; pressEnter(); return;
        }
        cout << "Yakin hapus \"" << daftarKendaraan[idx].nama << "\"? (1=Ya / 2=Batal) : ";
        int konfirm;
        if (!(cin >> konfirm)) { cin.clear(); bersihkanBuffer(); pressEnter(); return; }
        bersihkanBuffer();
        
        if (konfirm != 1) { cout << "[!] Dibatalkan.\n"; pressEnter(); return; }
        for (int i = idx; i < jmlKendaraan - 1; i++)
            daftarKendaraan[i] = daftarKendaraan[i + 1];
        jmlKendaraan--;
        for (int i = 0; i < jmlKendaraan; i++) daftarKendaraan[i].id = i + 1;
        
        simpanData();
        cout << "[OK] Kendaraan berhasil dihapus!\n";
    } else if (pilih == 2) {
        if (jmlTransaksi == 0) {
            cout << "Belum ada data transaksi.\n"; pressEnter(); return;
        }
        cout << "\nDaftar transaksi selesai:\n";
        garis();
        bool adaSelesai = false;
        for (int i = 0; i < jmlTransaksi; i++) {
            if (daftarTransaksi[i].sudahKembali) {
                int kIdx = cariIdxKendaraan(daftarTransaksi[i].idKendaraan);
                cout << "TRX-" << setw(4) << setfill('0') << daftarTransaksi[i].id << setfill(' ')
                     << "  Kendaraan: " << (kIdx != -1 ? daftarKendaraan[kIdx].nama : "?")
                     << "  Penyewa: "   << daftarTransaksi[i].namaPenyewa << "\n";
                adaSelesai = true;
            }
        }
        garis();
        if (!adaSelesai) {
            cout << "[!] Tidak ada transaksi yang sudah selesai.\n"; pressEnter(); return;
        }
        cout << "Masukkan ID transaksi yang dihapus : ";
        int idHapus;
        if (!(cin >> idHapus)) { cin.clear(); bersihkanBuffer(); pressEnter(); return; }
        bersihkanBuffer();

        int tIdx = cariIdxTransaksi(idHapus);
        if (tIdx == -1) { cout << "[!] ID transaksi tidak ditemukan.\n"; pressEnter(); return; }
        if (!daftarTransaksi[tIdx].sudahKembali) {
            cout << "[!] Transaksi masih aktif. Selesaikan pengembalian dulu!\n"; pressEnter(); return;
        }

        cout << "Yakin hapus transaksi TRX-" << setw(4) << setfill('0') << idHapus
             << setfill(' ') << "? (1=Ya / 2=Batal) : ";
        int konfirm;
        if (!(cin >> konfirm)) { cin.clear(); bersihkanBuffer(); pressEnter(); return; }
        bersihkanBuffer();
        if (konfirm != 1) { cout << "[!] Dibatalkan.\n"; pressEnter(); return; }

        for (int i = tIdx; i < jmlTransaksi - 1; i++)
            daftarTransaksi[i] = daftarTransaksi[i + 1];
        jmlTransaksi--;
        for (int i = 0; i < jmlTransaksi; i++) daftarTransaksi[i].id = i + 1;
        simpanData();
        cout << "[OK] Transaksi berhasil dihapus!\n";
    } else {
        cout << "[!] Pilihan tidak valid.\n";
    }
    pressEnter();
}
