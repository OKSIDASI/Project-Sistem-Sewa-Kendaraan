#include <iostream>
#include <fstream>
#include <cstring>
#include <cstdlib>
using namespace std;

const int MAX = 50;

struct Kendaraan {
    int    id;
    char   nama[50];
    char   jenis[10];
    char   plat[15];
    double harga;
    bool   tersedia;
};

struct Transaksi {
    int    id;
    int    idKendaraan;
    char   namaPenyewa[50];
    char   tanggalSewa[12];
    int    lamaSewa;
    double totalBayar;
    bool   sudahKembali;
};

Kendaraan kendaraan[MAX];
Transaksi transaksi[MAX];
int jmlKendaraan = 0;
int jmlTransaksi = 0;


void bersihkanBuffer() {
    char c;
    while (cin.get(c) && c != '\n');
}

void garis() {
    cout << "----------------------------------------\n";
}

int cariKendaraan(int id) {
    for (int i = 0; i < jmlKendaraan; i++)
        if (kendaraan[i].id == id) return i;
    return -1;
}

int cariTransaksi(int id) {
    for (int i = 0; i < jmlTransaksi; i++)
        if (transaksi[i].id == id) return i;
    return -1;
}


void simpanData() {
    ofstream fk("kendaraan.txt");
    if (!fk) { cout << "Gagal membuka file kendaraan.txt!\n"; return; }
    fk << jmlKendaraan << "\n";
    for (int i = 0; i < jmlKendaraan; i++) {
        fk << kendaraan[i].id       << "\n";
        fk << kendaraan[i].nama     << "\n";
        fk << kendaraan[i].jenis    << "\n";
        fk << kendaraan[i].plat     << "\n";
        fk << kendaraan[i].harga    << "\n";
        fk << kendaraan[i].tersedia << "\n";
    }
    fk.close();

    ofstream ft("transaksi.txt");
    if (!ft) { cout << "Gagal membuka file transaksi.txt!\n"; return; }
    ft << jmlTransaksi << "\n";
    for (int i = 0; i < jmlTransaksi; i++) {
        ft << transaksi[i].id           << "\n";
        ft << transaksi[i].idKendaraan  << "\n";
        ft << transaksi[i].namaPenyewa  << "\n";
        ft << transaksi[i].tanggalSewa  << "\n";
        ft << transaksi[i].lamaSewa     << "\n";
        ft << transaksi[i].totalBayar   << "\n";
        ft << transaksi[i].sudahKembali << "\n";
    }
    ft.close();
    cout << "Data berhasil disimpan ke file.\n";
}

void muatData() {
    ifstream fk("kendaraan.txt");
    if (!fk) {
        cout << "File kendaraan.txt tidak ditemukan. Mulai dengan data kosong.\n";
    } else {
        fk >> jmlKendaraan;
        fk.ignore();
        for (int i = 0; i < jmlKendaraan; i++) {
            fk >> kendaraan[i].id;
            fk.ignore();
            fk.getline(kendaraan[i].nama,  50);
            fk.getline(kendaraan[i].jenis, 10);
            fk.getline(kendaraan[i].plat,  15);
            fk >> kendaraan[i].harga >> kendaraan[i].tersedia;
            fk.ignore();
        }
        fk.close();
        cout << "Data kendaraan berhasil dimuat (" << jmlKendaraan << " data).\n";
    }

    ifstream ft("transaksi.txt");
    if (!ft) {
        cout << "File transaksi.txt tidak ditemukan. Mulai dengan data kosong.\n";
    } else {
        ft >> jmlTransaksi;
        ft.ignore();
        for (int i = 0; i < jmlTransaksi; i++) {
            ft >> transaksi[i].id >> transaksi[i].idKendaraan;
            ft.ignore();
            ft.getline(transaksi[i].namaPenyewa, 50);
            ft.getline(transaksi[i].tanggalSewa, 12);
            ft >> transaksi[i].lamaSewa >> transaksi[i].totalBayar >> transaksi[i].sudahKembali;
            ft.ignore();
        }
        ft.close();
        cout << "Data transaksi berhasil dimuat (" << jmlTransaksi << " data).\n";
    }
}


void tambahKendaraan() {
    system("cls");
    cout << "\n=== TAMBAH KENDARAAN ===\n";
    if (jmlKendaraan >= MAX) {
        cout << "Data penuh! Tidak bisa menambah kendaraan.\n";
        return;
    }
    Kendaraan k;
    k.id       = jmlKendaraan + 1;
    k.tersedia = true;

  
    cout << "Nama Kendaraan           : ";
    cin.getline(k.nama, 50);
    if (k.nama[0] == '\0') { cout << "Nama tidak boleh kosong!\n"; return; }

    int pilJenis;
    cout << "Jenis (1=Mobil, 2=Motor) : ";
    if (!(cin >> pilJenis) || (pilJenis != 1 && pilJenis != 2)) {
        cout << "Pilihan tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();


    if (pilJenis == 1) strcpy(k.jenis, "Mobil");
    else               strcpy(k.jenis, "Motor");

    cout << "Nomor Plat               : ";
    cin.getline(k.plat, 15);
    if (k.plat[0] == '\0') { cout << "Plat tidak boleh kosong!\n"; return; }

    cout << "Harga/Hari (Rp)          : ";
    if (!(cin >> k.harga) || k.harga <= 0) {
        cout << "Harga tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    kendaraan[jmlKendaraan++] = k;
    cout << "Kendaraan berhasil ditambahkan! ID: " << k.id << "\n";
    simpanData();
}


void tampilkanData() {
    system("cls");
    cout << "\n=== DATA KENDARAAN ===\n";
    if (jmlKendaraan == 0) { cout << "Belum ada data kendaraan.\n"; return; }
    garis();
    for (int i = 0; i < jmlKendaraan; i++) {
        Kendaraan& k = kendaraan[i];
        cout << "ID       : " << k.id    << "\n";
        cout << "Nama     : " << k.nama  << "\n";
        cout << "Jenis    : " << k.jenis << "\n";
        cout << "Plat     : " << k.plat  << "\n";
        cout << "Harga    : Rp " << k.harga << " / hari\n";
        cout << "Status   : " << (k.tersedia ? "Tersedia" : "Sedang Disewa") << "\n";
        garis();
    }
    cout << "Total kendaraan: " << jmlKendaraan << "\n";
}

void cariKendaraanMenu() {
    system("cls");
    cout << "\n=== CARI KENDARAAN ===\n";
    if (jmlKendaraan == 0) { cout << "Belum ada data kendaraan.\n"; return; }
