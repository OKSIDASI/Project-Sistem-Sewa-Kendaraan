}


void hargaKendaraan() {
    system("cls");
    cout << "\n=== SIMULASI HARGA SEWA ===\n";
    if (jmlKendaraan == 0) { cout << "Belum ada data kendaraan.\n"; return; }

    cout << "Daftar kendaraan tersedia:\n";
    garis();
    bool adaTersedia = false;
    for (int i = 0; i < jmlKendaraan; i++) {
        if (kendaraan[i].tersedia) {
            cout << "ID " << kendaraan[i].id << " - " << kendaraan[i].nama
                 << " | Rp " << kendaraan[i].harga << "/hari\n";
            adaTersedia = true;
        }
    }
    garis();
    if (!adaTersedia) { cout << "Semua kendaraan sedang disewa.\n"; return; }

    int idPilih;
    cout << "Masukkan ID kendaraan : ";
    if (!(cin >> idPilih)) {
        cout << "Input tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    int i = cariKendaraan(idPilih);
    if (i == -1) { cout << "Kendaraan tidak ditemukan.\n"; return; }


    if (!kendaraan[i].tersedia) {
        cout << "Kendaraan tersebut sedang disewa, tidak bisa disimulasikan.\n";
        return;
    }

    int hari;
    cout << "Lama sewa (hari)      : ";
    if (!(cin >> hari) || hari <= 0) {
        cout << "Jumlah hari tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    double total = kendaraan[i].harga * hari;
    cout << "Estimasi total biaya  : Rp " << total << " (" << hari << " hari)\n";
}

void sewaKendaraan() {
    system("cls");
    cout << "\n=== SEWA KENDARAAN ===\n";
    if (jmlKendaraan == 0) { cout << "Belum ada data kendaraan.\n"; return; }
    if (jmlTransaksi >= MAX) { cout << "Data transaksi penuh!\n"; return; }

    bool adaTersedia = false;
    cout << "Kendaraan tersedia:\n";
    garis();
    for (int i = 0; i < jmlKendaraan; i++) {
        if (kendaraan[i].tersedia) {
            cout << "ID " << kendaraan[i].id << " - " << kendaraan[i].nama
                 << " (" << kendaraan[i].jenis << ")"
                 << " | Rp " << kendaraan[i].harga << "/hari\n";
            adaTersedia = true;
        }
    }
    garis();
    if (!adaTersedia) { cout << "Semua kendaraan sedang disewa.\n"; return; }

    Transaksi t;
    t.id           = jmlTransaksi + 1;
    t.sudahKembali = false;

    cout << "ID kendaraan yang disewa  : ";
    if (!(cin >> t.idKendaraan)) {
        cout << "Input tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    int idx = cariKendaraan(t.idKendaraan);
    if (idx == -1) { cout << "Kendaraan tidak ditemukan.\n"; return; }
    if (!kendaraan[idx].tersedia) { cout << "Kendaraan sedang tidak tersedia.\n"; return; }

    cout << "Nama penyewa              : "; cin.getline(t.namaPenyewa, 50);
    if (t.namaPenyewa[0] == '\0') { cout << "Nama tidak boleh kosong!\n"; return; }

    cout << "Tanggal sewa (DD/MM/YYYY) : "; cin.getline(t.tanggalSewa, 12);
    if (t.tanggalSewa[0] == '\0') { cout << "Tanggal tidak boleh kosong!\n"; return; }

    cout << "Lama sewa (hari)          : ";
    if (!(cin >> t.lamaSewa) || t.lamaSewa <= 0) {
        cout << "Lama sewa tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    t.totalBayar = kendaraan[idx].harga * t.lamaSewa;
    garis();
    cout << "ID Transaksi : " << t.id                << "\n";
    cout << "Kendaraan    : " << kendaraan[idx].nama << "\n";
    cout << "Penyewa      : " << t.namaPenyewa        << "\n";
    cout << "Tanggal Sewa : " << t.tanggalSewa        << "\n";
    cout << "Lama Sewa    : " << t.lamaSewa            << " hari\n";
    cout << "Total Bayar  : Rp " << t.totalBayar      << "\n";
    garis();

    int konfirm;
    cout << "Konfirmasi sewa? (1=Ya, 2=Batal) : ";
    if (!(cin >> konfirm)) { cin.clear(); bersihkanBuffer(); return; }
    bersihkanBuffer();
    if (konfirm != 1) { cout << "Transaksi dibatalkan.\n"; return; }

    transaksi[jmlTransaksi++] = t;
    kendaraan[idx].tersedia   = false;
    cout << "Sewa berhasil! ID Transaksi: " << t.id << "\n";
    simpanData();
}


void pengembalianKendaraan() {
    system("cls");
    cout << "\n=== PENGEMBALIAN KENDARAAN ===\n";
    if (jmlTransaksi == 0) { cout << "Belum ada data transaksi.\n"; return; }

    bool adaAktif = false;
    cout << "Transaksi aktif:\n";
    garis();
    for (int i = 0; i < jmlTransaksi; i++) {
        if (!transaksi[i].sudahKembali) {
            int idx = cariKendaraan(transaksi[i].idKendaraan);
            cout << "ID Transaksi " << transaksi[i].id
                 << " | Kendaraan: " << (idx != -1 ? kendaraan[idx].nama : "?")
                 << " | Penyewa: "   << transaksi[i].namaPenyewa << "\n";
            adaAktif = true;
        }
    }
    garis();
    if (!adaAktif) { cout << "Tidak ada kendaraan yang sedang disewa.\n"; return; }

    int idTrx;
    cout << "Masukkan ID transaksi : ";
    if (!(cin >> idTrx)) {
        cout << "Input tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    int tIdx = cariTransaksi(idTrx);
    if (tIdx == -1) { cout << "ID transaksi tidak ditemukan.\n"; return; }
    if (transaksi[tIdx].sudahKembali) { cout << "Kendaraan sudah dikembalikan.\n"; return; }

    int keterlambatan;
    cout << "Hari keterlambatan (0 jika tepat waktu) : ";
    if (!(cin >> keterlambatan) || keterlambatan < 0) {
        cout << "Input tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    int    kIdx      = cariKendaraan(transaksi[tIdx].idKendaraan);
    double denda     = 0;
    if (keterlambatan > 0 && kIdx != -1)
        denda = keterlambatan * kendaraan[kIdx].harga * 1.5;

    double totalAkhir = transaksi[tIdx].totalBayar + denda;
    garis();
    cout << "Penyewa      : " << transaksi[tIdx].namaPenyewa   << "\n";
    cout << "Total Sewa   : Rp " << transaksi[tIdx].totalBayar << "\n";
    if (denda > 0) cout << "Denda        : Rp " << denda       << "\n";
    cout << "TOTAL BAYAR  : Rp " << totalAkhir                  << "\n";
    garis();

    int konfirm;
    cout << "Konfirmasi pengembalian? (1=Ya, 2=Batal) : ";
    if (!(cin >> konfirm)) { cin.clear(); bersihkanBuffer(); return; }
    bersihkanBuffer();
    if (konfirm != 1) { cout << "Pengembalian dibatalkan.\n"; return; }

    transaksi[tIdx].sudahKembali = true;
    transaksi[tIdx].totalBayar   = totalAkhir;
    if (kIdx != -1) kendaraan[kIdx].tersedia = true;
    cout << "Pengembalian berhasil! Terima kasih.\n";
    simpanData();
}


void sortingKendaraan() {
    system("cls");
    cout << "\n=== SORTING KENDARAAN ===\n";
    if (jmlKendaraan == 0) { cout << "Belum ada data kendaraan.\n"; return; }

    int urutan;
    cout << "Urutkan berdasarkan harga:\n";
    cout << "  1. Termurah ke Termahal\n";
    cout << "  2. Termahal ke Termurah\n";
    cout << "Pilih : ";
    if (!(cin >> urutan) || (urutan != 1 && urutan != 2)) {
        cout << "Pilihan tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();


    Kendaraan temp[MAX];
    for (int i = 0; i < jmlKendaraan; i++) temp[i] = kendaraan[i];

    for (int i = 0; i < jmlKendaraan - 1; i++) {
        for (int j = 0; j < jmlKendaraan - 1 - i; j++) {
            bool perluTukar = (urutan == 1)
                ? temp[j].harga > temp[j+1].harga
                : temp[j].harga < temp[j+1].harga;
            if (perluTukar) {
                Kendaraan swap = temp[j];
                temp[j]        = temp[j+1];
                temp[j+1]      = swap;
            }
        }
    }

    cout << "Hasil pengurutan:\n";
    garis();
    for (int i = 0; i < jmlKendaraan; i++) {
        cout << i+1 << ". [ID " << temp[i].id << "] " << temp[i].nama
             << " (" << temp[i].jenis << ")"
             << " | Rp " << temp[i].harga << "/hari"
             << " | " << (temp[i].tersedia ? "Tersedia" : "Disewa") << "\n";
    }
    garis();
}

void hapusData() {
    system("cls");
    cout << "\n=== HAPUS DATA ===\n";
    cout << " 1. Hapus Kendaraan\n";
    cout << " 2. Hapus Transaksi\n";
    cout << "Pilih : ";
    int pilih;
    if (!(cin >> pilih) || (pilih != 1 && pilih != 2)) {
        cout << "Pilihan tidak valid!\n";
        cin.clear(); bersihkanBuffer(); return;
    }
    bersihkanBuffer();

    if (pilih == 1) {
        if (jmlKendaraan == 0) { cout << "Belum ada data kendaraan.\n"; return; }
        cout << "\nDaftar kendaraan:\n";
        garis();
        for (int i = 0; i < jmlKendaraan; i++) {
            cout << "ID " << kendaraan[i].id
                 << " - " << kendaraan[i].nama
                 << " (" << kendaraan[i].jenis << ")"
                 << " | " << (kendaraan[i].tersedia ? "Tersedia" : "Sedang Disewa") << "\n";
        }
        garis();

        int idHapus;
        cout << "Masukkan ID kendaraan yang dihapus : ";
        if (!(cin >> idHapus)) {
            cout << "Input tidak valid!\n";
            cin.clear(); bersihkanBuffer(); return;
        }
        bersihkanBuffer();

        int idx = cariKendaraan(idHapus);
        if (idx == -1) { cout << "ID kendaraan tidak ditemukan.\n"; return; }
        if (!kendaraan[idx].tersedia) {
            cout << "Tidak bisa menghapus kendaraan yang sedang disewa!\n";
            return;
        }

        cout << "Yakin hapus kendaraan \"" << kendaraan[idx].nama << "\"? (1=Ya, 2=Batal) : ";
        int konfirm;
        if (!(cin >> konfirm)) { cin.clear(); bersihkanBuffer(); return; }
        bersihkanBuffer();
        if (konfirm != 1) { cout << "Penghapusan dibatalkan.\n"; return; }

    
        for (int i = idx; i < jmlKendaraan - 1; i++)
            kendaraan[i] = kendaraan[i + 1];
        jmlKendaraan--;


        for (int i = 0; i < jmlKendaraan; i++)
            kendaraan[i].id = i + 1;

        cout << "Kendaraan berhasil dihapus!\n";
        simpanData();
    }
    else {
        if (jmlTransaksi == 0) { cout << "Belum ada data transaksi.\n"; return; }
        cout << "\nDaftar transaksi:\n";
        garis();
        for (int i = 0; i < jmlTransaksi; i++) {
            int idx = cariKendaraan(transaksi[i].idKendaraan);
            cout << "ID Transaksi " << transaksi[i].id
                 << " | Kendaraan: " << (idx != -1 ? kendaraan[idx].nama : "?")
                 << " | Penyewa: "   << transaksi[i].namaPenyewa
                 << " | Status: "    << (transaksi[i].sudahKembali ? "Selesai" : "Aktif") << "\n";
        }
        garis();

        int idHapus;
        cout << "Masukkan ID transaksi yang dihapus : ";
        if (!(cin >> idHapus)) {
            cout << "Input tidak valid!\n";
            cin.clear(); bersihkanBuffer(); return;
        }
        bersihkanBuffer();

        int tIdx = cariTransaksi(idHapus);
        if (tIdx == -1) { cout << "ID transaksi tidak ditemukan.\n"; return; }
        if (!transaksi[tIdx].sudahKembali) {
            cout << "Tidak bisa menghapus transaksi yang masih aktif!\n";
            cout << "Selesaikan pengembalian terlebih dahulu.\n";
            return;
        }

        cout << "Yakin hapus transaksi ID " << idHapus << "? (1=Ya, 2=Batal) : ";
        int konfirm;
        if (!(cin >> konfirm)) { cin.clear(); bersihkanBuffer(); return; }
        bersihkanBuffer();
        if (konfirm != 1) { cout << "Penghapusan dibatalkan.\n"; return; }

        for (int i = tIdx; i < jmlTransaksi - 1; i++)
            transaksi[i] = transaksi[i + 1];
        jmlTransaksi--;

        for (int i = 0; i < jmlTransaksi; i++)
            transaksi[i].id = i + 1;

        cout << "Transaksi berhasil dihapus!\n";
        simpanData();
    }
}


int main() {
    cout << "Memuat data...\n";
    muatData();

    int pilih;
    do {
        system("cls");
        cout << "\n==============================\n";
        cout << "   SISTEM SEWA KENDARAAN     \n";
        cout << "==============================\n";
        cout << " 1. Tambah Kendaraan\n";
        cout << " 2. Tampilkan Data Kendaraan\n";
        cout << " 3. Cari Kendaraan\n";
        cout << " 4. Harga Kendaraan\n";
        cout << " 5. Sewa Kendaraan\n";
        cout << " 6. Pengembalian Kendaraan\n";
        cout << " 7. Sorting Kendaraan\n";
        cout << " 8. Hapus Data\n";
        cout << " 9. Keluar\n";
        cout << "==============================\n";
        cout << "Pilih Menu : ";

        if (!(cin >> pilih)) {
            cout << "Input tidak valid! Masukkan angka 1-9.\n";
            cin.clear(); bersihkanBuffer();
            pilih = 0; continue;
        }
        bersihkanBuffer();

        if (pilih < 1 || pilih > 9) {
            cout << "Menu tidak tersedia! Pilih 1-9.\n";
            continue;
        }

        switch (pilih) {
            case 1: tambahKendaraan();       break;
            case 2: tampilkanData();         break;
            case 3: cariKendaraanMenu();     break;
            case 4: hargaKendaraan();        break;
            case 5: sewaKendaraan();         break;
            case 6: pengembalianKendaraan(); break;
            case 7: sortingKendaraan();      break;
            case 8: hapusData();             break;
            case 9: cout << "\nProgram selesai. Terima kasih!\n"; break;
        }
    } while (pilih != 9);

    return 0;
}
